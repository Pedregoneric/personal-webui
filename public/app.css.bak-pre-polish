/* Personal WebUI — ChatGPT-like restrained UI */

:root, [data-theme="dark"] {
  color-scheme: dark;
  --bg: #212121;
  --bg-sidebar: #181818;
  --bg-elevated: #2f2f2f;
  --bg-hover: #2a2a2a;
  --bg-active: #303030;
  --border: rgba(255, 255, 255, 0.08);
  --border-strong: rgba(255, 255, 255, 0.12);
  --text: #ececec;
  --text-2: #b4b4b4;
  --text-3: #8e8e8e;
  --user-bubble: #2f2f2f;
  --composer-bg: #303030;
  --send: #fff;
  --send-fg: #0d0d0d;
  --danger: #f87171;
  --green: #4ade80;
  --focus: rgba(255, 255, 255, 0.18);
  --chat-max: min(48rem, 100%);
  --sidebar-w: 260px;
  --companion-w: 280px;
  --cast-w: 200px;
  --font: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --radius: 1.5rem;
  --radius-sm: 0.875rem;
  font-family: var(--font);
}

[data-theme="light"] {
  color-scheme: light;
  --bg: #ffffff;
  --bg-sidebar: #f9f9f9;
  --bg-elevated: #f4f4f4;
  --bg-hover: #ececec;
  --bg-active: #e8e8e8;
  --border: rgba(0, 0, 0, 0.08);
  --border-strong: rgba(0, 0, 0, 0.12);
  --text: #0d0d0d;
  --text-2: #5d5d5d;
  --text-3: #8f8f8f;
  --user-bubble: #f4f4f4;
  --composer-bg: #f4f4f4;
  --send: #0d0d0d;
  --send-fg: #fff;
  --danger: #dc2626;
  --green: #16a34a;
  --focus: rgba(0, 0, 0, 0.12);
}

/* Accents kept for settings compatibility but stay subtle */
[data-accent="neutral"],
[data-accent="violet"],
[data-accent="purple"],
[data-accent="blue"],
[data-accent="cyan"],
[data-accent="rose"],
[data-accent="amber"],
[data-accent="gold"],
[data-accent="green"] {
  /* intentionally monochrome product chrome */
}

[data-chat-width="narrow"] { --chat-max: min(40rem, 100%); }
[data-chat-width="wide"] { --chat-max: min(48rem, 100%); }
[data-chat-width="full"] { --chat-max: min(56rem, 100%); }
[data-density="compact"] .message { margin-bottom: 1rem; }
[data-density="compact"] .message-body { font-size: 0.95em; }

* { box-sizing: border-box; }
html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
body {
  background: var(--bg);
  color: var(--text);
  height: 100%;
  height: var(--app-height, 100svh);
  font-size: calc(16px * var(--font-scale, 1));
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
button, input, textarea, select { font: inherit; color: inherit; }
button { appearance: none; cursor: pointer; border: 0; background: none; }
button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
  outline: 2px solid var(--text-2);
  outline-offset: 2px;
}
.hidden { display: none !important; }
.mobile-only { display: none !important; }
.sr-only {
  position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}
.muted { color: var(--text-2); }
.muted.sm, .sm { font-size: 0.8125rem; }

/* Layout shells */
.shell {
  position: fixed;
  top: var(--app-top, 0);
  left: var(--app-left, 0);
  display: grid;
  width: var(--app-width, 100vw);
  height: var(--app-height, 100svh);
  overflow: hidden;
}
body[data-layout="chat"] .shell {
  grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
  grid-template-areas: "sidebar workspace";
}
body[data-layout="chat"] .companion-panel,
body[data-layout="chat"] .cast-rail,
body[data-layout="chat"] .scene-header,
body[data-layout="chat"] .studio-stage { display: none !important; }

body[data-layout="companion"] .shell {
  grid-template-columns: var(--sidebar-w) var(--companion-w) minmax(0, 1fr);
  grid-template-areas: "sidebar companion workspace";
}
body[data-layout="companion"] .companion-panel { display: flex; }
body[data-layout="companion"] .cast-rail,
body[data-layout="companion"] .scene-header,
body[data-layout="companion"] .studio-stage { display: none !important; }

body[data-layout="story"] .shell {
  grid-template-columns: var(--sidebar-w) var(--cast-w) minmax(0, 1fr);
  grid-template-areas: "sidebar cast workspace";
}
body[data-layout="story"] .cast-rail { display: flex; }
body[data-layout="story"] .scene-header { display: block; }
body[data-layout="story"] .companion-panel,
body[data-layout="story"] .studio-stage { display: none !important; }

body[data-layout="studio"] .shell {
  grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
  grid-template-areas: "sidebar workspace";
}
body[data-layout="studio"] .companion-panel,
body[data-layout="studio"] .cast-rail,
body[data-layout="studio"] .scene-header { display: none !important; }
body[data-layout="studio"] .studio-stage { display: grid; }
body[data-layout="studio"] .workspace {
  grid-template-rows: auto auto minmax(0, 1fr) minmax(0, 0.45fr) auto;
}
body[data-layout="studio"] .main-pane { border-top: 1px solid var(--border); }
body[data-layout="studio"] .empty-inner h1 { font-size: 1.25rem; }

.sidebar { grid-area: sidebar; }
.companion-panel { grid-area: companion; }
.cast-rail { grid-area: cast; }
.workspace { grid-area: workspace; }

/* Sidebar — flat, ChatGPT-like */
.sidebar {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  padding: 0.75rem;
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border);
}
.sidebar-top {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}
.btn-new {
  flex: 1;
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  min-height: 2.5rem;
  padding: 0 0.875rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border-strong);
  background: transparent;
  color: var(--text);
  font-size: 0.875rem;
  font-weight: 500;
}
.btn-new:hover { background: var(--bg-hover); }

.mode-rail {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  margin-bottom: 0.75rem;
  padding: 0.125rem;
}
.mode-btn {
  flex: 1 1 calc(50% - 0.25rem);
  min-height: 2rem;
  padding: 0.375rem 0.5rem;
  border-radius: 0.5rem;
  color: var(--text-2);
  font-size: 0.8125rem;
  font-weight: 500;
  text-align: center;
}
.mode-btn:hover { background: var(--bg-hover); color: var(--text); }
.mode-btn.active {
  background: var(--bg-elevated);
  color: var(--text);
}
.mode-btn .mode-ico { display: none; }
.mode-btn .mode-name { display: block; }

.search-field { display: block; margin-bottom: 0.5rem; }
.search-field input {
  width: 100%;
  min-height: 2.25rem;
  padding: 0.5rem 0.75rem;
  border-radius: 0.625rem;
  border: 0;
  background: var(--bg-elevated);
  color: var(--text);
  font-size: 0.875rem;
}
.search-field input::placeholder { color: var(--text-3); }
.search-field input:focus { outline: none; box-shadow: 0 0 0 1px var(--border-strong); }

.thread-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem 0.5rem 0.25rem;
  color: var(--text-3);
  font-size: 0.75rem;
  font-weight: 500;
}
.thread-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding-bottom: 0.5rem;
  scrollbar-width: thin;
  scrollbar-color: var(--bg-elevated) transparent;
}
.thread-item {
  display: block;
  width: 100%;
  margin: 0.125rem 0;
  padding: 0.625rem 0.75rem;
  border-radius: 0.625rem;
  text-align: left;
  color: var(--text);
  font-size: 0.875rem;
}
.thread-item:hover { background: var(--bg-hover); }
.thread-item.active { background: var(--bg-active); }
.thread-item strong {
  display: block;
  font-size: 0.875rem;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.thread-item > span {
  display: block;
  margin-top: 0.125rem;
  color: var(--text-3);
  font-size: 0.75rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.thread-meta-row { display: none; }

.sidebar-bottom {
  border-top: 1px solid var(--border);
  padding-top: 0.5rem;
}
.rail-link {
  display: block;
  width: 100%;
  padding: 0.625rem 0.75rem;
  border-radius: 0.625rem;
  color: var(--text-2);
  font-size: 0.875rem;
  text-align: left;
}
.rail-link:hover { background: var(--bg-hover); color: var(--text); }
.sidebar-meta {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 0.5rem 0.25rem;
}
.status-dot {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  flex: 1;
  color: var(--text-3);
  font-size: 0.75rem;
}
.status-dot i {
  width: 0.375rem;
  height: 0.375rem;
  border-radius: 50%;
  background: var(--green);
}
.status-dot.busy i { background: #fbbf24; }
.status-dot.err i { background: var(--danger); }
.status-dot em { font-style: normal; }
.text-link {
  color: var(--text-3);
  font-size: 0.75rem;
}
.text-link:hover { color: var(--text); }

.icon-btn {
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 0.625rem;
  display: inline-grid;
  place-items: center;
  color: var(--text-2);
}
.icon-btn:hover { background: var(--bg-hover); color: var(--text); }
.icon-btn.quiet { width: 1.75rem; height: 1.75rem; }

/* Side panels — restrained */
.companion-panel,
.cast-rail {
  flex-direction: column;
  gap: 0.875rem;
  padding: 1rem;
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border);
  min-height: 0;
  overflow: auto;
}
.companion-hero { text-align: left; padding: 0.25rem 0 0.5rem; }
.companion-avatar {
  width: 3rem;
  height: 3rem;
  margin-bottom: 0.75rem;
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-size: 1rem;
  font-weight: 600;
  background: var(--bg-elevated);
  color: var(--text-2);
}
.companion-hero h2 {
  margin: 0 0 0.25rem;
  font-size: 1rem;
  font-weight: 600;
}
.companion-hero p {
  margin: 0;
  color: var(--text-2);
  font-size: 0.875rem;
  line-height: 1.45;
}
.companion-block label,
.cast-head {
  display: block;
  margin-bottom: 0.375rem;
  color: var(--text-3);
  font-size: 0.75rem;
  font-weight: 500;
}
.companion-block select,
.companion-block textarea {
  width: 100%;
  border-radius: 0.625rem;
  border: 1px solid var(--border);
  background: var(--bg);
  padding: 0.625rem 0.75rem;
  font-size: 0.875rem;
}
.companion-block.grow { flex: 1; display: flex; flex-direction: column; }
.companion-block.grow textarea { flex: 1; min-height: 6rem; resize: vertical; }
.companion-block .btn-secondary { margin-top: 0.5rem; align-self: flex-start; }

.cast-list { flex: 1; overflow: auto; display: flex; flex-direction: column; gap: 0.25rem; }
.cast-item {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  width: 100%;
  padding: 0.5rem;
  border-radius: 0.625rem;
  text-align: left;
  color: var(--text);
}
.cast-item:hover, .cast-item.active { background: var(--bg-hover); }
.cast-item .av {
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-size: 0.75rem;
  font-weight: 600;
  background: var(--bg-elevated);
  color: var(--text-2);
}
.cast-item strong { display: block; font-size: 0.8125rem; font-weight: 500; }
.cast-item span span { display: none; }

/* Workspace */
.workspace {
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr) auto;
  min-width: 0;
  min-height: 0;
  background: var(--bg);
}
.topbar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 3.25rem;
  padding: 0.5rem 1rem;
}
.thread-meta { flex: 1; min-width: 0; text-align: center; }
.thread-meta strong {
  display: block;
  font-size: 0.9375rem;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.top-actions {
  display: flex;
  align-items: center;
  gap: 0.125rem;
}
.pill {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  min-height: 1.75rem;
  padding: 0 0.625rem;
  border-radius: 999px;
  color: var(--text-3);
  font-size: 0.75rem;
}
.pill i {
  width: 0.375rem;
  height: 0.375rem;
  border-radius: 50%;
  background: var(--green);
}
.pill.busy i { background: #fbbf24; }
.pill.err i { background: var(--danger); }

.btn-ghost,
.btn-secondary,
.btn-primary,
.btn-danger {
  min-height: 2rem;
  padding: 0 0.75rem;
  border-radius: 0.625rem;
  font-size: 0.8125rem;
  font-weight: 500;
}
.btn-ghost { color: var(--text-2); }
.btn-ghost:hover { background: var(--bg-hover); color: var(--text); }
.btn-secondary {
  border: 1px solid var(--border-strong);
  background: transparent;
  color: var(--text);
}
.btn-secondary:hover { background: var(--bg-hover); }
.btn-primary {
  background: var(--send);
  color: var(--send-fg);
}
.btn-primary:hover { filter: brightness(0.95); }
.btn-danger { color: var(--danger); }
.btn-danger.subtle { background: transparent; }
.btn-secondary.sm, .btn-primary.sm { min-height: 1.75rem; font-size: 0.75rem; }
.btn-secondary.full, .wide { width: 100%; }
.btn-primary.wide {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  min-height: 2.5rem;
}

.scene-header {
  padding: 0.5rem 1.25rem 0.875rem;
  border-bottom: 1px solid var(--border);
}
.scene-title-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  justify-content: center;
}
.scene-title-row strong { font-size: 0.9375rem; font-weight: 500; }
.scene-tag {
  color: var(--text-3);
  font-size: 0.75rem;
}
.scene-notes-preview {
  margin: 0.25rem 0 0;
  text-align: center;
  color: var(--text-3);
  font-size: 0.8125rem;
}

/* Studio */
.studio-stage {
  grid-template-columns: minmax(0, 1.5fr) minmax(260px, 0.7fr);
  min-height: 0;
  border-bottom: 1px solid var(--border);
}
.studio-canvas {
  min-height: 16rem;
  max-height: 42vh;
  display: grid;
  place-items: center;
  padding: 1rem;
  background: var(--bg-sidebar);
}
.studio-empty { text-align: center; max-width: 20rem; color: var(--text-2); }
.studio-empty h2 {
  margin: 0 0 0.375rem;
  color: var(--text);
  font-size: 1.125rem;
  font-weight: 500;
}
.studio-empty p { margin: 0; font-size: 0.875rem; }
.studio-preview {
  max-width: 100%;
  max-height: 38vh;
  border-radius: 0.75rem;
  object-fit: contain;
}
.studio-dock {
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
  padding: 1rem;
  border-left: 1px solid var(--border);
  background: var(--bg);
  overflow: auto;
}
.studio-dock-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.875rem;
}
.studio-field {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  min-width: 0;
}
.studio-field label {
  color: var(--text-3);
  font-size: 0.75rem;
  font-weight: 500;
}
.studio-field input,
.studio-field select,
.studio-field textarea,
.studio-dock textarea {
  width: 100%;
  border-radius: 0.625rem;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  padding: 0.55rem 0.7rem;
  font-size: 0.875rem;
  color: var(--text);
}
.studio-field textarea,
.studio-dock textarea {
  min-height: 4.25rem;
  resize: vertical;
  line-height: 1.4;
}
.studio-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.5rem;
}
.studio-row .studio-field:first-child:nth-last-child(2),
.studio-row .studio-field:first-child:nth-last-child(2) ~ .studio-field {
  grid-column: auto;
}
.studio-styles {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}
.studio-style-chip {
  min-height: 1.75rem;
  padding: 0 0.625rem;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-2);
  font-size: 0.75rem;
  font-weight: 500;
}
.studio-style-chip:hover,
.studio-style-chip.active {
  background: var(--bg-hover);
  color: var(--text);
}
.studio-dock-row {
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
  flex-wrap: wrap;
}
@media (max-width: 960px) {
  .studio-row { grid-template-columns: 1fr 1fr; }
}
.studio-thumbs {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(4rem, 1fr));
  gap: 0.375rem;
}
.studio-thumbs button {
  aspect-ratio: 1;
  border-radius: 0.5rem;
  overflow: hidden;
  border: 1px solid var(--border);
  padding: 0;
  background: var(--bg-elevated);
}
.studio-thumbs img { width: 100%; height: 100%; object-fit: cover; display: block; }

/* Main chat */
.main-pane {
  min-height: 0;
  overflow: auto;
  display: flex;
  flex-direction: column;
  scrollbar-width: thin;
  scrollbar-color: var(--bg-elevated) transparent;
}
.empty-state {
  margin: auto;
  width: min(40rem, 100%);
  padding: 3rem 1.25rem 4rem;
}
.empty-inner { text-align: center; }
.empty-inner h1 {
  margin: 0 0 0.5rem;
  font-size: clamp(1.5rem, 3vw, 1.875rem);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.25;
}
.empty-inner .lead {
  margin: 0 auto 1.75rem;
  max-width: 28rem;
  color: var(--text-2);
  font-size: 0.9375rem;
}
.suggestions {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  gap: 0.625rem;
  text-align: left;
}
.suggestions button {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.25rem;
  min-height: 4.5rem;
  padding: 0.875rem 1rem;
  border-radius: 0.875rem;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  transition: background 0.12s ease;
}
.suggestions button:hover { background: var(--bg-hover); }
.suggestions button strong {
  font-size: 0.875rem;
  font-weight: 500;
}
.suggestions button span {
  color: var(--text-3);
  font-size: 0.8125rem;
  line-height: 1.35;
}

.conversation {
  width: min(var(--chat-max), 100%);
  margin: 0 auto;
  padding: 1rem 1.25rem 2rem;
}
.message {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}
.message.user { justify-content: flex-end; }
.message .avatar { display: none; }
.message-main { min-width: 0; max-width: min(100%, 42rem); }
.message.user .message-main {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.message-label { display: none; }
.message-bubble {
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  border-radius: 0;
}
.message.user .message-bubble {
  padding: 0.75rem 1rem;
  border-radius: 1.375rem;
  background: var(--user-bubble);
}
.message.assistant .message-bubble {
  padding: 0.125rem 0;
}
.message-body {
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 1rem;
}
.message-body :is(p, ul, ol, pre, blockquote) { margin: 0 0 0.75em; }
.message-body :is(p, ul, ol, pre, blockquote):last-child { margin-bottom: 0; }
.message-body :is(ul, ol) { padding-left: 1.25em; }
.message-body code {
  padding: 0.1em 0.3em;
  border-radius: 0.3rem;
  background: var(--bg-elevated);
  font-family: var(--mono);
  font-size: 0.9em;
}
.message-body pre {
  padding: 0.875rem 1rem;
  border-radius: 0.75rem;
  background: var(--bg-sidebar);
  border: 1px solid var(--border);
  overflow-x: auto;
  font-family: var(--mono);
  font-size: 0.875em;
}
.message-body pre code { padding: 0; background: none; }
.message-body a { color: var(--text); text-decoration: underline; }
.msg-image {
  display: block;
  max-width: min(100%, 24rem);
  max-height: 28rem;
  margin: 0.5rem 0;
  border-radius: 0.75rem;
  object-fit: contain;
  background: var(--bg-sidebar);
}
.message.streaming .message-body::after {
  content: "●";
  margin-left: 0.25rem;
  color: var(--text-3);
  animation: blink 1s step-end infinite;
}
@keyframes blink { 50% { opacity: 0; } }

.jump-latest {
  position: sticky;
  bottom: 0.75rem;
  align-self: center;
  z-index: 5;
  margin: 0 auto 0.5rem;
  padding: 0.5rem 0.875rem;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: var(--bg);
  color: var(--text-2);
  font-size: 0.8125rem;
}

/* Composer */
.composer-wrap {
  padding: 0 1rem calc(1rem + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--bg) 60%, transparent);
}
.composer-shell {
  width: min(var(--chat-max), 100%);
  margin: 0 auto;
}
.composer {
  border: 1px solid var(--border-strong);
  border-radius: var(--radius);
  background: var(--composer-bg);
  padding: 0.5rem 0.625rem 0.375rem;
}
.composer:focus-within {
  border-color: var(--text-3);
}
.composer-top {
  display: flex;
  gap: 0.25rem;
  align-items: flex-end;
}
.composer textarea {
  flex: 1;
  min-height: 2.75rem;
  max-height: 10rem;
  resize: none;
  border: 0;
  background: transparent;
  padding: 0.625rem 0.375rem;
  outline: none;
  line-height: 1.45;
  font-size: 1rem;
}
.composer textarea::placeholder { color: var(--text-3); }
.composer-ico {
  width: 2.25rem;
  height: 2.25rem;
  flex: 0 0 auto;
  color: var(--text-2);
}
.send-btn {
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 999px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  background: var(--send);
  color: var(--send-fg);
}
.send-btn:hover { filter: brightness(0.94); }
.composer-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  padding: 0.125rem 0.25rem 0.25rem;
  flex-wrap: wrap;
}
.composer-settings {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  flex: 1;
  min-width: 0;
}
.field-chip {
  display: inline-flex;
  align-items: center;
  min-height: 1.75rem;
  padding: 0 0.125rem;
  color: var(--text-3);
  font-size: 0.75rem;
}
.field-chip select {
  max-width: 10rem;
  min-height: 1.75rem;
  border: 0;
  background: transparent;
  color: var(--text-2);
  font-size: 0.75rem;
  font-weight: 500;
  padding: 0 0.25rem;
}
.composer-hint {
  margin: 0;
  color: var(--text-3);
  font-size: 0.6875rem;
  min-height: 1em;
}

.image-gen-panel {
  margin-bottom: 0.625rem;
  padding: 0.75rem;
  border-radius: 1rem;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
}
.image-gen-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.5rem;
  font-size: 0.875rem;
}
.image-gen-panel textarea {
  width: 100%;
  min-height: 3.5rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border);
  background: var(--bg);
  padding: 0.625rem 0.75rem;
  resize: vertical;
  font-size: 0.875rem;
}
.image-gen-actions {
  display: flex;
  gap: 0.5rem;
  justify-content: flex-end;
  margin-top: 0.5rem;
}

.character-card-strip,
.template-row {
  width: min(var(--chat-max), 100%);
  margin: 0.5rem auto 0;
  padding: 0 1.25rem;
}
.char-card {
  display: flex;
  gap: 0.75rem;
  align-items: center;
  padding: 0.75rem;
  border-radius: 0.875rem;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
}
.char-card-avatar {
  width: 2rem;
  height: 2rem;
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-weight: 600;
  background: var(--bg);
  color: var(--text-2);
}
.char-card-body strong { display: block; font-size: 0.875rem; font-weight: 500; }
.char-card-body span {
  display: block;
  margin-top: 0.125rem;
  color: var(--text-3);
  font-size: 0.75rem;
}

/* Forms / modals */
label input, label select, label textarea,
.modal input, .modal select, .modal textarea,
.library-editor input, .library-editor textarea, .library-editor select {
  width: 100%;
  min-height: 2.5rem;
  padding: 0.625rem 0.75rem;
  border-radius: 0.625rem;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
  color: var(--text);
  font-size: 0.875rem;
}
label textarea, .modal textarea, .library-editor textarea {
  min-height: 5rem;
  resize: vertical;
  line-height: 1.45;
}
label input:focus, label select:focus, label textarea:focus,
.modal input:focus, .modal select:focus, .modal textarea:focus {
  outline: none;
  border-color: var(--text-3);
}

.modal, .tip-modal {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: grid;
  place-items: center;
  padding: 1rem;
  background: rgba(0, 0, 0, 0.55);
}
.modal.hidden, .tip-modal.hidden { display: none !important; }
.modal-card {
  width: min(32rem, 100%);
  max-height: min(90vh, 56rem);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: 1rem;
  background: var(--bg);
}
.modal-card.wide { width: min(52rem, 100%); }
.modal-card.tall { max-height: min(92vh, 60rem); }
.modal-header, .modal-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.625rem;
  padding: 0.875rem 1rem;
  border-bottom: 1px solid var(--border);
}
.modal-footer {
  border-bottom: 0;
  border-top: 1px solid var(--border);
  justify-content: flex-end;
}
.footer-spacer { flex: 1; }
.modal-header h2 {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
}
.modal-kicker { display: none; }
.modal-body { padding: 1rem; overflow: auto; }
.prefs-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.875rem;
}
.prefs-grid label {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  font-size: 0.8125rem;
  color: var(--text-2);
  font-weight: 500;
}
.prefs-grid label.full { grid-column: 1 / -1; }
.prefs-grid label.check {
  flex-direction: row;
  align-items: center;
  gap: 0.5rem;
  color: var(--text);
  font-size: 0.875rem;
  min-height: 2.5rem;
}
.prefs-grid label.check input { width: auto; min-height: 0; }
.prefs-section h3 { margin: 0.25rem 0; font-size: 0.875rem; font-weight: 600; color: var(--text); }
.prefs-section p { margin: 0; font-size: 0.8125rem; line-height: 1.4; }
.comfy-test-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  align-items: center;
}
.provider-line {
  padding: 0.625rem 0.75rem;
  border-radius: 0.625rem;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  font-size: 0.75rem;
}
.llm-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}
.llm-preset-btn {
  min-height: 1.875rem;
  padding: 0 0.625rem;
  border-radius: 999px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-2);
  font-size: 0.75rem;
  font-weight: 500;
}
.llm-preset-btn:hover {
  background: var(--bg-hover);
  color: var(--text);
}
.llm-provider-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  padding: 0.875rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border);
  background: var(--bg-sidebar);
}
.llm-provider-card .full { grid-column: 1 / -1; }
.llm-provider-card label {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  font-size: 0.8125rem;
  color: var(--text-2);
  font-weight: 500;
}
@media (max-width: 640px) {
  .llm-provider-card { grid-template-columns: 1fr; }
}

.tabs {
  display: flex;
  gap: 0.25rem;
  padding: 0 1rem;
  border-bottom: 1px solid var(--border);
}
.tab {
  padding: 0.75rem 0.75rem;
  border-bottom: 2px solid transparent;
  color: var(--text-2);
  font-weight: 500;
  font-size: 0.875rem;
}
.tab.active {
  color: var(--text);
  border-bottom-color: var(--text);
}
.library-body {
  display: grid;
  grid-template-columns: 13rem minmax(0, 1fr);
  gap: 0.875rem;
  min-height: 24rem;
}
.library-list {
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  overflow: auto;
  background: var(--bg-sidebar);
}
.library-list button {
  display: block;
  width: 100%;
  padding: 0.625rem 0.75rem;
  border: 0;
  border-bottom: 1px solid var(--border);
  background: transparent;
  color: var(--text);
  text-align: left;
  font-size: 0.875rem;
}
.library-list button.active,
.library-list button:hover { background: var(--bg-hover); }
.library-editor { display: flex; flex-direction: column; gap: 0.625rem; }
.library-editor label {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
  font-size: 0.8125rem;
  color: var(--text-2);
  font-weight: 500;
}
.library-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.25rem; }
.gallery-toolbar {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.875rem;
  flex-wrap: wrap;
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
  gap: 0.625rem;
}
.gallery-item {
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  overflow: hidden;
  background: var(--bg-elevated);
  text-align: left;
  padding: 0;
  color: var(--text);
}
.gallery-item img {
  display: block;
  width: 100%;
  height: 6.5rem;
  object-fit: cover;
  background: var(--bg-sidebar);
}
.gallery-item .meta {
  padding: 0.5rem 0.625rem;
  font-size: 0.75rem;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.prompt-pre {
  margin: 0;
  padding: 0.875rem;
  border-radius: 0.75rem;
  background: var(--bg-sidebar);
  border: 1px solid var(--border);
  white-space: pre-wrap;
  word-break: break-word;
  font-family: var(--mono);
  font-size: 0.75rem;
  line-height: 1.5;
  max-height: 70vh;
  overflow: auto;
}

.tip-dialog {
  position: relative;
  width: min(24rem, 100%);
  padding: 1.5rem 1.25rem 1.25rem;
  border: 1px solid var(--border);
  border-radius: 1rem;
  background: var(--bg);
  text-align: center;
}
.tip-close { position: absolute; top: 0.5rem; right: 0.5rem; }
.tip-icon { display: none; }
.tip-dialog h2 {
  margin: 0 0 0.5rem;
  font-size: 1.125rem;
  font-weight: 600;
}
.tip-dialog > p {
  margin: 0 auto 1rem;
  max-width: 28ch;
  color: var(--text-2);
  font-size: 0.875rem;
  line-height: 1.5;
}
.tip-amounts {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}
.tip-amount {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
  padding: 0.75rem 0.5rem;
  border-radius: 0.75rem;
  border: 1px solid var(--border);
  color: var(--text);
  text-decoration: none;
}
.tip-amount:hover { background: var(--bg-hover); }
.tip-amount strong { font-size: 0.9375rem; }
.tip-amount span { color: var(--text-3); font-size: 0.75rem; }
.tip-link { margin-top: 0.25rem; }

/* Login */
.login-page {
  display: grid;
  place-items: center;
  min-height: var(--app-height, 100svh);
  padding: 1.5rem;
  background: var(--bg);
}
.login-card {
  width: min(22rem, 100%);
  padding: 1.75rem 1.5rem;
  border-radius: 1rem;
  border: 1px solid var(--border);
  background: var(--bg);
  text-align: center;
}
.login-card .brand-mark {
  width: 2.5rem;
  height: 2.5rem;
  margin: 0 auto 1rem;
  border-radius: 0.75rem;
  display: grid;
  place-items: center;
  font-weight: 700;
  background: var(--bg-elevated);
  color: var(--text);
}
.login-card h1 {
  margin: 0.25rem 0 0.5rem;
  font-size: 1.375rem;
  font-weight: 600;
  letter-spacing: -0.02em;
}
.login-card .eyebrow {
  margin: 0;
  color: var(--text-3);
  font-size: 0.75rem;
  font-weight: 500;
}
.login-card .muted {
  margin: 0 0 1.25rem;
  color: var(--text-2);
  line-height: 1.5;
  font-size: 0.875rem;
}
.login-card label {
  display: block;
  text-align: left;
  margin: 0.625rem 0 0.375rem;
  color: var(--text-2);
  font-size: 0.8125rem;
  font-weight: 500;
}
.login-card input {
  width: 100%;
  min-height: 2.5rem;
  padding: 0.625rem 0.75rem;
  border-radius: 0.625rem;
  border: 1px solid var(--border);
  background: var(--bg-elevated);
}
.login-card .btn-primary,
.login-card .primary {
  width: 100%;
  margin-top: 0.875rem;
  min-height: 2.5rem;
  border-radius: 0.75rem;
  background: var(--send);
  color: var(--send-fg);
  font-weight: 500;
  border: 0;
}
.error {
  color: var(--danger);
  min-height: 1.2em;
  font-size: 0.8125rem;
  text-align: left;
}
.secure-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  color: var(--text-3);
  font-size: 0.75rem;
  margin-top: 1rem;
}
.secure-note span { color: var(--green); }
.login-tip-link { margin-top: 0.625rem; }
.login-tip-link a {
  color: var(--text-2);
  text-decoration: none;
  font-size: 0.8125rem;
}
.login-tip-link a:hover { color: var(--text); text-decoration: underline; }

/* Mobile */
@media (max-width: 960px) {
  .mobile-only { display: inline-grid !important; }
  body[data-layout="chat"] .shell,
  body[data-layout="companion"] .shell,
  body[data-layout="story"] .shell,
  body[data-layout="studio"] .shell {
    grid-template-columns: 1fr;
    grid-template-areas: "workspace";
  }
  .sidebar-scrim {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 35;
    background: rgba(0, 0, 0, 0.45);
  }
  .sidebar-scrim[hidden] { display: none !important; }
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(18rem, 86vw);
    z-index: 40;
    transform: translateX(-105%);
    transition: transform 0.2s ease;
  }
  .sidebar.open { transform: translateX(0); }
  .companion-panel, .cast-rail { display: none !important; }
  .studio-stage { grid-template-columns: 1fr; }
  .studio-canvas { max-height: 32vh; min-height: 12rem; }
  .library-body { grid-template-columns: 1fr; }
  .prefs-grid { grid-template-columns: 1fr; }
  .thread-meta { text-align: left; }
  .top-actions .btn-ghost { display: none; }
  .top-actions #open-chat-settings,
  .top-actions #stop-gen { display: inline-flex; }
  .suggestions { grid-template-columns: 1fr; }
}

@media (max-width: 520px) {
  .composer { border-radius: 1.25rem; }
  .field-chip select { max-width: 7rem; }
}
